# ---------- AegisStore configuration ----------
# Copy to .env:  cp .env.example .env

# --- Admin account seeded on first boot (change the password!) ---
ADMIN_EMAIL=admin@aegis.local
ADMIN_PASSWORD=ChangeMe123!

# --- Infrastructure ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_DB=aegis
# Used by api/worker (inside compose the host names are 'postgres' / 'redis')
DATABASE_URL=postgres://aegis:aegis_dev_password@postgres:5432/aegis
REDIS_URL=redis://redis:6379

# --- Secrets (generate real ones for anything beyond local dev) ---
# Shared by api, worker and storage nodes for the internal /internal/* API
NODE_SHARED_SECRET=dev-node-secret-change-me
# Signs share links (used from Phase 11)
SIGNED_URL_SECRET=dev-signed-url-secret-change-me

# --- Cluster behaviour ---
REPLICATION_FACTOR=2
VNODES_PER_NODE=128
HEARTBEAT_INTERVAL_MS=5000
OFFLINE_AFTER_MS=15000
# Returning nodes must send this many heartbeats before becoming HEALTHY again
PROBATION_BEATS=3
# Virtual capacity per storage node (bytes). 10 GiB by default.
NODE_CAPACITY_BYTES=10737418240
# Single-request upload limit in bytes (100 MB). Larger files need multipart (Phase 11).
MAX_UPLOAD_BYTES=104857600
# Deleted / overwritten data stays restorable this long before the purge frees it
RETENTION_HOURS=24
# Downloads up to this size are fully verified BEFORE the first byte is sent
VERIFY_BUFFER_MAX_BYTES=16777216

# --- Self-healing ---
# Wait this long before re-replicating away from an OFFLINE node (avoids thrashing on restarts)
HEAL_GRACE_MS=60000
# Concurrent repair copies, so healing never starves user traffic
REPAIR_CONCURRENCY=2
# Every replica is re-hashed at least this often (HOT objects every 24 h)
SCRUB_MAX_AGE_HOURS=168

# --- Abuse protection (per source IP) ---
REGISTER_RATE_LIMIT=10   # registrations per hour
LOGIN_RATE_LIMIT=10      # login attempts per 15 minutes per IP+email

# --- Web / cookies ---
# Set to true when serving over HTTPS
COOKIE_SECURE=false
# Extra allowed browser origins for cookie-authenticated writes (comma separated)
ALLOWED_ORIGINS=http://localhost:8080
LOG_LEVEL=info
